# Docker Compose deployment settings.
# Copy to .env in the project root and edit:  cp deploy.env.example .env
# (docker compose reads .env automatically for ${VAR} substitution.)

# Domain the Caddy reverse proxy serves (must point at this host's IP).
# If unset, Caddy boots with a local self-signed cert for localhost.
NOTTEN_HOME_DOMAIN=notten.example.com

# Image published by CI to GHCR. Pin a tag for reproducible deploys, e.g.
# ghcr.io/shlee-dev012/notten_home:sha-abc1234
NOTTEN_HOME_IMAGE=ghcr.io/shlee-dev012/notten_home:latest

# Optional: for Let's Encrypt cert-expiry notices, add to the Caddyfile:
#   { email you@example.com }
